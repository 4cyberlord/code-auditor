{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "council-solve-dispatch",
  "account_id": "2f1fd5442ab4f1ed35ebe0bf67430eb4",
  "main": "src/index.js",
  "compatibility_date": "2026-10-15",
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "vpc_services": [
    {
      "binding": "NIMO_WAKE",
      "service_id": "01a152b4-19a7-7c83-aa22-9a53deabcac2",
      "remote": true
    }
  ],
  "queues": {
    "producers": [
      {
        "queue": "council-solve-dispatch",
        "binding": "SOLVE_DISPATCH"
      }
    ],
    "consumers": [
      {
        "queue": "council-solve-dispatch",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "retry_delay": 5
      }
    ]
  }
}
