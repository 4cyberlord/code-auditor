{
  "name": "council-editor",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "helper:dev": "node scripts/run-helper-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node tests/auth.test.ts && node tests/consensus.test.ts && node tests/phase2Execution.test.mjs && node tests/problemRouting.test.ts && node tests/visualStructure.test.ts && node tests/propertyVerification.test.ts && node tests/propertyAssessment.test.ts && node tests/trustedPropertyFixtures.test.ts && node tests/adaptiveModelRouting.test.ts && node tests/verifiedModelAnalytics.test.ts && node tests/signedBenchmark.test.ts && node tests/authenticatedBenchmarkRouting.test.ts && node tests/benchmarkFeed.test.ts && node tests/benchmarkSigner.test.ts && node tests/benchmarkRunner.test.ts && node tests/benchmarkContainer.test.ts && node tests/releasePreflight.test.mjs",
    "helper:build": "node scripts/build-helper.mjs",
    "helper:sidecar": "node scripts/prepare-tauri-build.mjs",
    "helper:sidecar:dev": "node scripts/prepare-tauri-build.mjs --profile debug --skip-frontend",
    "ghost:install": "node scripts/ghost-install.mjs",
    "ghost:uninstall": "node scripts/ghost-uninstall.mjs",
    "ghost:detect": "node scripts/ghost-detect.mjs",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "api:deploy": "node scripts/deploy-api.mjs",
    "knowledge:publish": "node scripts/seed-knowledge.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run check:rust",
    "tauri": "tauri",
    "app:dev": "npm run helper:sidecar:dev && tauri dev",
    "app:build": "tauri build --bundles app && node scripts/package-dmg.mjs",
    "app:build:signed": "node scripts/build-signed.mjs",
    "release:preflight": "node scripts/release-preflight.mjs"
  },
  "dependencies": {
    "@e2b/code-interpreter": "^2.7.2",
    "@sentry/node": "^10.71.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-opener": "^2.2.2",
    "@upstash/qstash": "^2.11.3",
    "next": "^16.3.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5",
    "@types/node": "^24.13.3",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "postcss": "^8.5.26",
    "sharp": "^0.35.3"
  }
