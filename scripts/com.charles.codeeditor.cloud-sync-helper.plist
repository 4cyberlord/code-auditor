<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.charles.codeeditor.cloud-sync-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Applications/Code Editor.app/Contents/MacOS/cloud-sync-helper</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/cloud-sync-helper.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cloud-sync-helper.err.log</string>
</dict>
</plist>
