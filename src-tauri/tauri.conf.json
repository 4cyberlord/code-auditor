{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Council Editor",
  "mainBinaryName": "council-editor",
  "version": "0.1.0",
  "identifier": "com.charles.councileditor",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3001",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "node scripts/prepare-tauri-build.mjs"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Council Editor",
        "width": 1500,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Multi-agent code, math and research solver",
    "externalBin": [
      "binaries/mds"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
