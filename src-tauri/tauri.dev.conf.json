{
  "identifier": "com.charles.councileditor.dev",
  "productName": "Council Editor Dev",
  "build": {
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": {
      "script": "npm run dev:services",
      "cwd": "..",
      "wait": false
    }
  },
  "app": {
    "windows": [
      {
        "title": "Council Editor Dev",
        "width": 1500,
        "height": 980,
        "minWidth": 1080,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ]
  }
}
